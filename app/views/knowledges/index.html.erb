<section class="page-header">
  <div>
    <h1>社内ナレッジ一覧</h1>
    <p class="page-lead">社内マニュアル、FAQ、業務ルールをまとめて確認できます。</p>
  </div>

  <%= link_to "+ 新しいナレッジ", new_knowledge_path, class: "button button-primary" %>
</section>

<section class="toolbar">
  <%= form_with url: knowledges_path, method: :get, class: "search-form" do |form| %>
    <div class="form-group search-form__field">
      <%= form.label :q, "検索" %>
      <%= form.search_field :q, value: @query, placeholder: "タイトル、本文、カテゴリで検索" %>
    </div>
    <%= form.submit "検索", class: "button button-secondary" %>
  <% end %>
</section>

<% if @knowledges.any? %>
  <div class="knowledge-grid">
    <% @knowledges.each do |knowledge| %>
      <article class="knowledge-card">
        <p class="badge">カテゴリ: <%= knowledge.category %></p>
        <h2><%= link_to knowledge.title, knowledge_path(knowledge) %></h2>
        <p class="knowledge-card__content"><%= truncate(knowledge.content, length: 160) %></p>
        <%= link_to "詳細を見る", knowledge_path(knowledge), class: "card-link" %>
      </article>
    <% end %>
  </div>
<% else %>
  <section class="empty-state">
    <h2>ナレッジが見つかりません</h2>
    <p>登録されているナレッジはありません。</p>
    <%= link_to "+ 新しいナレッジ", new_knowledge_path, class: "button button-primary" %>
  </section>
<% end %>
