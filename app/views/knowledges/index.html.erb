<h1>社内ナレッジ一覧</h1>

<% if notice.present? %>
  <p><%= notice %></p>
<% end %>

<p><%= link_to "新規登録", new_knowledge_path %></p>

<%= form_with url: knowledges_path, method: :get do |form| %>
  <div>
    <%= form.label :q, "検索" %>
    <%= form.search_field :q, value: @query %>
    <%= form.submit "検索" %>
  </div>
<% end %>

<% if @knowledges.any? %>
  <ul>
    <% @knowledges.each do |knowledge| %>
      <li>
        <h2><%= link_to knowledge.title, knowledge_path(knowledge) %></h2>
        <p>カテゴリ: <%= knowledge.category %></p>
        <p><%= knowledge.content %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>登録されているナレッジはありません。</p>
<% end %>
