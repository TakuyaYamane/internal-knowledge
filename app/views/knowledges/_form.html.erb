<% if knowledge.errors.any? %>
  <div class="error-panel">
    <p>入力内容を確認してください。</p>
    <ul>
      <% knowledge.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: knowledge, class: "form-card" do |form| %>
  <div class="form-group">
    <%= form.label :title, "タイトル" %>
    <%= form.text_field :title, placeholder: "例: 経費精算の方法" %>
  </div>

  <div class="form-group">
    <%= form.label :category, "カテゴリ" %>
    <%= form.text_field :category, placeholder: "例: 経費" %>
  </div>

  <div class="form-group">
    <%= form.label :content, "本文" %>
    <%= form.text_area :content, rows: 12, placeholder: "社内ナレッジの本文を入力してください。" %>
  </div>

  <div class="form-actions">
    <%= form.submit submit_label, class: "button button-primary" %>
  </div>
<% end %>
