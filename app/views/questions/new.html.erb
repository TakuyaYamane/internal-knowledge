<section class="question-hero">
  <p class="eyebrow">AI Knowledge Search</p>
  <h1>社内質問</h1>
  <h2>社内ナレッジに質問</h2>
  <p>社内ナレッジを検索し、関連情報をもとにAIが回答します。</p>

  <%= form_with url: questions_path, method: :get, class: "question-form" do |form| %>
    <div class="form-group">
      <%= form.label :question, "質問" %>
      <%= form.text_area :question, rows: 6, placeholder: "例: 社外から会社のシステムに入りたい" %>
    </div>

    <div class="form-actions">
      <%= form.submit "質問する", class: "button button-primary button-large" %>
    </div>
  <% end %>
</section>

<div class="action-bar">
  <%= link_to "ナレッジ一覧へ", knowledges_path, class: "button button-secondary" %>
</div>
