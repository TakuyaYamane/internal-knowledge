<section class="page-header page-header--stacked">
  <h1>ナレッジに質問</h1>
  <p class="page-lead">質問、AI回答、参照したナレッジの順に確認できます。</p>
</section>

<section class="question-summary">
  <h2>質問</h2>
    <div class="question-examples">
    <p class="question-examples-title">質問例</p>

    <div class="question-example-list">
      <button type="button" class="question-example-button"
        onclick="document.getElementById('question').value = 'リモートワークは週に何日できますか？'">
        リモートワークは週に何日できますか？
      </button>

      <button type="button" class="question-example-button"
        onclick="document.getElementById('question').value = '有給休暇はいつまでに申請すればいいですか？'">
        有給休暇はいつまでに申請すればいいですか？
      </button>

      <button type="button" class="question-example-button"
        onclick="document.getElementById('question').value = '社内勉強会はいつ開催されますか？'">
        社内勉強会はいつ開催されますか？
      </button>

      <button type="button" class="question-example-button"
        onclick="document.getElementById('question').value = '本番環境で障害が発生したら最初に何をすればいいですか？'">
        本番障害が発生したら最初に何をすればいいですか？
      </button>

      <button type="button" class="question-example-button"
        onclick="document.getElementById('question').value = 'コードレビューのルールを教えてください'">
        コードレビューのルールを教えてください
      </button>

      <button type="button" class="question-example-button"
        onclick="document.getElementById('question').value = '金曜日に参加できる社内イベントはありますか？'">
        金曜日に参加できる社内イベントはありますか？
      </button>
    </div>
  </div>
  <%= form_with url: questions_path, method: :get, class: "question-form question-form--compact" do |form| %>
    <div class="form-group">
      <%= form.label :question, "質問" %>
      <%= form.text_area :question, value: @question, rows: 4 %>
    </div>

    <div class="form-actions">
      <%= form.submit "質問する", class: "button button-primary" %>
    </div>
  <% end %>
</section>

<% if @question.blank? %>
  <section class="empty-state">
    <h2>質問が未入力です</h2>
    <p>質問を入力してください。</p>
  </section>
<% else %>
  <% if @ai_answer_result&.success? %>
    <section class="answer-card">
      <h2>AI回答</h2>
      <p><%= @ai_answer_result.answer %></p>
    </section>
  <% elsif @ai_answer_result.present? %>
    <section class="notice-card">
      <p><%= @ai_answer_result.error_message %></p>
    </section>
  <% end %>
<% end %>

<% if @knowledges.any? %>
  <section class="section-block">
    <h2>関連するナレッジ</h2>
    <p class="section-lead">AI回答が参照した社内ナレッジです。</p>

    <div class="knowledge-grid">
      <% @knowledges.each do |knowledge| %>
        <article class="knowledge-card">
          <p class="badge">カテゴリ: <%= knowledge.category %></p>
          <h3><%= link_to knowledge.title, knowledge_path(knowledge) %></h3>
          <p class="knowledge-card__content"><%= truncate(knowledge.content, length: 160) %></p>
          <%= link_to "詳細を見る", knowledge_path(knowledge), class: "card-link" %>
        </article>
      <% end %>
    </div>
  </section>
<% elsif @question.present? %>
  <section class="empty-state">
    <h2>参照ナレッジなし</h2>
    <p>関連するナレッジは見つかりませんでした。</p>
  </section>
<% end %>

<div class="action-bar">
  <%= link_to "ナレッジ一覧へ", knowledges_path, class: "button button-secondary" %>
</div>
